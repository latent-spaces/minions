{
  "name": "@minions/server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node ../../tests/run.mjs",
    "typecheck": "tsc --noEmit",
    "build:backend": "tsc -p tsconfig.build.json",
    "start:self-hosted": "node dist/self-hosted-main.js start",
    "self-hosted": "node dist/self-hosted-main.js",
    "export:catalog": "tsx scripts/export-project-tool-catalog.ts",
    "prebuild:backend": "npm --prefix ../../packages/contracts run build"
  },
  "dependencies": {
    "@minions/contracts": "0.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "firebase-admin": "14.5.0",
    "helmet": "8.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "license": "MIT"
}
