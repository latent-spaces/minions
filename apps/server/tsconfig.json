{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "test",
    "scripts",
    "vitest.config.ts",
    "../../tests/integration",
    "../../tools/benchmarks",
  ],
  "exclude": [
    "../../tests/integration/**/*.test.tsx"
  ]
}
